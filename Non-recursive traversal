#include<stdio.h>
#include<stdlib.h>

#define MAX_SIZE 100

typedef struct TreeNode {
    int data;
    struct TreeNode* left;
    struct TreeNode* right;
} TreeNode;

typedef struct Stack {
    TreeNode* data[MAX_SIZE];
    int top;
} Stack;

void initStack(Stack* s) {
    s->top = -1;
}

int isEmpty(Stack* s) {
    return s->top == -1;
}

int isFull(Stack* s) {
    return s->top == MAX_SIZE - 1;
}

// 入栈
void push(Stack* s, TreeNode* node) {
    if (isFull(s)) {
        printf("栈已满\n");
        return;
    }
    s->data[++(s->top)] = node;
}

// 出栈
TreeNode* pop(Stack* s) {
    if (isEmpty(s)) {
        printf("栈为空\n");
        return NULL;
    }
    return s->data[(s->top)--];
}

// 获取栈顶元素
TreeNode* peek(Stack* s) {
    if (isEmpty(s)) {
        return NULL;
    }
    return s->data[s->top];
}

TreeNode* createNode(int value) {
    TreeNode* newNode = (TreeNode*)malloc(sizeof(TreeNode));
    if (newNode == NULL) {
        printf("内存分配失败\n");
        exit(1);
    }
    newNode->data = value;
    newNode->left = NULL;
    newNode->right = NULL;
    return newNode;
}

// 非递归先序遍历
void preorderTraversalIterative(TreeNode* root) {
    if (root == NULL) return;

    Stack s;
    initStack(&s);
    push(&s, root);

    printf("非递归先序遍历: ");
    while (!isEmpty(&s)) {
        TreeNode* current = pop(&s);
        printf("%d ", current->data);

        // 注意先右后左的顺序，因为栈是先进后出
        if (current->right != NULL) {
            push(&s, current->right);
        }
        if (current->left != NULL) {
            push(&s, current->left);
        }
    }
    printf("\n");
}

// 非递归中序遍历
void inorderTraversalIterative(TreeNode* root) {
    Stack s;
    initStack(&s);
    TreeNode* current = root;

    printf("非递归中序遍历: ");
    while (current != NULL || !isEmpty(&s)) {
        // 将左子树全部入栈
        while (current != NULL) {
            push(&s, current);
            current = current->left;
        }

        current = pop(&s);
        printf("%d ", current->data);

        // 转向右子树
        current = current->right;
    }
    printf("\n");
}

// 非递归后序遍历（使用两个栈）
void postorderTraversalIterative(TreeNode* root) {
    if (root == NULL) return;

    Stack s1, s2;
    initStack(&s1);
    initStack(&s2);
    push(&s1, root);

    printf("非递归后序遍历: ");
    while (!isEmpty(&s1)) {
        TreeNode* current = pop(&s1);
        push(&s2, current);

        if (current->left != NULL) {
            push(&s1, current->left);
        }
        if (current->right != NULL) {
            push(&s1, current->right);
        }
    }

    // 输出s2中的元素
    while (!isEmpty(&s2)) {
        printf("%d ", pop(&s2)->data);
    }
    printf("\n");
}

int main() {
    TreeNode* root = createNode(1);
    root->left = createNode(2);
    root->right = createNode(3);
    root->left->left = createNode(4);
    root->left->right = createNode(5);

    preorderTraversalIterative(root);
    inorderTraversalIterative(root);
    postorderTraversalIterative(root);

    free(root->left->left);
    free(root->left->right);
    free(root->left);
    free(root->right);
    free(root);

    return 0;
}
