#define  _CRT_SECURE_NO_WARNINGS 1
#define MaxSize 50
#include<stdio.h>
#include <stdbool.h>

typedef int Datatype;
typedef struct
{
	Datatype data[MaxSize];
	int top;
}Seqstack;

//初始化
void initStack(Seqstack *S) {
	S->top = -1;
}

//判断栈空
bool EmptyStack(Seqstack *S) {
	if (S->top == -1) {
		return true;
	}
	return false;
}
//bool EmptyStack(Seqstack* S) {
//	return S->top == -1;
//}

// 判断栈满
bool FullStack(Seqstack* S) {
	if (S->top == MaxSize - 1) {
		return true;
	}
	return false;
}

//添加
bool Push(Seqstack* S, Datatype e) {
	if (S->top == MaxSize - 1) {
		return false;
	}
	S->data[++S->top] = e;
	return true;
}

//删除
bool Pop(Seqstack* S, Datatype *e) {
	if (S->top == -1) {
		return false;
	}
	e = S->data[S->top--];
	return true;
}

//取栈顶
bool GetTop(Seqstack* S, Datatype *x) {
	if (EmptyStack(S)) {
		printf("栈空\n");
		return false;
	}
	*x = S->data[S->top];
	return true;
}

//遍历
bool ShowStack(Seqstack* S) {
	if (EmptyStack(S)) {
		printf("栈空\n");
		return false;
	}
	int temp = S->top;
	while (temp != -1) {
		printf("%d", S->data[temp]);
		temp--;
	}
	printf("\n");
	return true;
}
int main() {
	Seqstack S;
	initStack(&S);
	Push(&S, 1);
	Push(&S, 2);
	Push(&S, 3);
	ShowStack(&S);
	Datatype x;
	Pop(&S, &x);
	ShowStack(&S);

}
