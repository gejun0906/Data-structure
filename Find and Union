#define  _CRT_SECURE_NO_WARNINGS 1
#include <stdio.h>
#include <stdlib.h>

#define MAX_SIZE 100

typedef struct {
    int parent[MAX_SIZE];
    int rank[MAX_SIZE];  // 用于按秩合并优化
    int size;           // 并查集大小
} DSU;

// 初始化并查集
void initDSU(DSU* dsu, int size) {
    dsu->size = size;
    for (int i = 0; i < size; i++) {
        dsu->parent[i] = i;  // 初始时每个元素是自己的父节点
        dsu->rank[i] = 0;    // 初始秩为0
    }
}

// 查找操作（路径压缩优化）
int find(DSU* dsu, int x) {
    if (dsu->parent[x] != x) {
        dsu->parent[x] = find(dsu, dsu->parent[x]);  // 路径压缩
    }
    return dsu->parent[x];
}

// 合并操作（按秩合并优化）
void unionSets(DSU* dsu, int x, int y) {
    int rootX = find(dsu, x);
    int rootY = find(dsu, y);

    if (rootX == rootY) return;  // 已经在同一集合

    // 按秩合并
    if (dsu->rank[rootX] < dsu->rank[rootY]) {
        dsu->parent[rootX] = rootY;
    }
    else if (dsu->rank[rootX] > dsu->rank[rootY]) {
        dsu->parent[rootY] = rootX;
    }
    else {
        dsu->parent[rootY] = rootX;
        dsu->rank[rootX]++;
    }
}

// 检查两个元素是否在同一集合
int isConnected(DSU* dsu, int x, int y) {
    return find(dsu, x) == find(dsu, y);
}

int main() {
    DSU dsu;
    initDSU(&dsu, 10);  // 创建大小为10的并查集

    unionSets(&dsu, 1, 2);
    unionSets(&dsu, 2, 3);
    unionSets(&dsu, 4, 5);

    printf("1和3是否连接: %d\n", isConnected(&dsu, 1, 3));  // 输出1 (true)
    printf("1和4是否连接: %d\n", isConnected(&dsu, 1, 4));  // 输出0 (false)

    unionSets(&dsu, 3, 4);
    printf("1和5是否连接: %d\n", isConnected(&dsu, 1, 5));  // 输出1 (true)

    return 0;
}
