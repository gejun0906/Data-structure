#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// 构建部分匹配表(Partial Match Table)
void computeLPSArray(const char* pattern, int pattern_len, int* lps) {
    int len = 0;  // 当前最长前缀后缀的长度
    lps[0] = 0;   // lps[0]总是0

    int i = 1;
    while (i < pattern_len) {
        if (pattern[i] == pattern[len]) {
            len++;
            lps[i] = len;
            i++;
        }
        else {
            if (len != 0) {
                len = lps[len - 1];
            }
            else {
                lps[i] = 0;
                i++;
            }
        }
    }
}

// KMP搜索算法
void KMPSearch(const char* text, const char* pattern) {
    int text_len = strlen(text);
    int pattern_len = strlen(pattern);

    // 创建部分匹配表
    int* lps = (int*)malloc(sizeof(int) * pattern_len);
    computeLPSArray(pattern, pattern_len, lps);

    int i = 0;  // text的索引
    int j = 0;  // pattern的索引
    while (i < text_len) {
        if (pattern[j] == text[i]) {
            i++;
            j++;
        }

        if (j == pattern_len) {
            printf("找到匹配模式在索引 %d\n", i - j);
            j = lps[j - 1];
        }
        else if (i < text_len && pattern[j] != text[i]) {
            if (j != 0) {
                j = lps[j - 1];
            }
            else {
                i++;
            }
        }
    }

    free(lps);  // 释放内存
}

int main() {
    char text[] = "ABABDABACDABABCABAB";
    char pattern[] = "ABABCABAB";

    printf("文本: %s\n", text);
    printf("模式: %s\n", pattern);
    printf("匹配结果:\n");

    KMPSearch(text, pattern);

    return 0;
}
