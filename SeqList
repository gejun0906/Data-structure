//添加元素
int AddList(SeqList* L, DataType e) {
	if (L->length >= MAXLEN) {
		printf("表已满");
		return -1;
	}
	L->data[L->length] = e;
	L->length++;
	return 1;
}

//添加多个元素
void CreatList(SeqList* L, int n) {
	int i = 0;
	printf("输入%d个元素", n);
	for (i = 0;i < n; i++) {
		scanf("%d", L->data[i]);
	}
	L->length = i;
}

//遍历
void TravelList(SeqList* L) {
	int i = 0;
	for (i = 0;i < L->length; i++) {
		printf("%d ", L->data[i]);
	}
	printf("\n");
}

//插入
int InsertList(SeqList* L, int pos, DataType x) {
	if (L->length == MAXLEN) {
		printf("表已满");
		return -1;
	}
	if (pos < 1 || pos > L->length  + 1) {
		printf("插入位置出错");
		return -1;
	}
	if (pos == L->length + 1) {
		L->data[pos - 1] = x;
		L->length++;
		return 1;
	}
	for (int i = L->length; i >= pos; i--) {
		L->data[i] = L->data[i -1];
	}
	L->data[pos - 1] = x;
	L->length++;
	return 1;
}

//删除
int DeleteList(SeqList* L, int pos, DataType *e) {
	if (L->length == 0) {
		printf("表空");
		return -1;
	}
	if (pos < 1 || pos > L->length) {
		printf("不存在第%d个元素", &pos);
		return -1;
	}
	*e = L->data[pos - 1];
	for (int i = pos; i < L->length; i++) {
		L->data[i - 1] = L->data[i];
	}
	L->length--;
	return 1;

}

//查找
int FindList(SeqList* L, DataType e) {
	if (L->length == 0) {
		printf("表空");
		return -1;
	}
	for (int i = 0; i < L->length; i++) {
		if (L->data[i] == e) {
			return i + 1;
		}
	}
	return -1;
}

